# ==============================================================================
# FieldOps Agent - Production Environment Template
# Copy to .env in production environment and update placeholder secrets.
# ==============================================================================

# Core environment mode
APP_ENV=production
DEBUG=false

# Database & Cache connection strings
DATABASE_URL=postgresql+psycopg://fieldops:YOUR_SECURE_POSTGRES_PASSWORD@postgres:5432/fieldops
REDIS_URL=redis://redis:6379/0
DB_POOL_RECYCLE_SECONDS=1800

# LangGraph Shared Checkpoint Storage (Must be 'postgres' in production)
CHECKPOINTER_BACKEND=postgres
CHECKPOINT_POSTGRES_POOL_SIZE=10

# Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# LLM Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# Business Scheduling Parameters
BUSINESS_TIMEZONE=Asia/Tokyo
DEFAULT_APPOINTMENT_DURATION_MINUTES=120
DEFAULT_SLOT_STEP_MINUTES=60

# External Integration Providers
CALENDAR_PROVIDER=fake
EMAIL_PROVIDER=fake
ALLOW_FAKE_INTEGRATIONS_IN_PRODUCTION=false

# Inbound Intake & Security
WEBHOOK_SHARED_SECRET=
ENABLE_FAKE_INTAKE=false
CORS_ORIGINS=["https://fieldops.example.com"]

# Required deployment secrets: generate and set locally; never commit real values.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
JWT_SECRET=
