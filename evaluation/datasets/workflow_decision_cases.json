      "error_type": "appointment_conflict",
      "is_side_effect_safe": true
    },
    "expected_action": "reschedule",
    "expected_route": "reschedule_subgraph",
    "expected_reason_code": "APPOINTMENT_CONFLICT"
  },
  {
    "id": "case_07_llm_timeout",
    "description": "Transient LLM provider timeout is classified as retryable within retry budget.",
    "input": {
      "error_type": "llm_timeout",
      "attempt_count": 1,
      "retry_budget": 3,
      "is_side_effect_safe": true
    },
    "expected_action": "retry",
    "expected_retryable": true,
    "expected_reason_code": "TRANSIENT_INFRASTRUCTURE_FAILURE"
  },
  {
    "id": "case_08_google_calendar_temporary_failure",
    "description": "Auxiliary Google Calendar synchronization 503 does not rollback core appointment; schedules async recovery.",
    "input": {
      "error_type": "calendar_sync_transient",
      "is_side_effect_safe": true
    },
    "expected_action": "continue",
    "expected_retryable": true,
    "expected_reason_code": "INTEGRATION_RECOVERY_REQUIRED"
  },
  {
    "id": "case_09_google_calendar_auth_failure",
    "description": "Google Calendar 401 permanent authorization failure routes to administrator intervention queue.",
    "input": {
