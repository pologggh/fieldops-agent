  },
  {
    "id": "case_05_sla_impossible",
    "description": "High urgency request where candidate technicians cannot arrive within SLA window triggers SLA escalation.",
    "input": {
      "service_type": "HVAC",
      "urgency": "high",
      "location": "Shinjuku",
      "preferred_time": "tomorrow morning",
      "required_skills": ["HVAC"],
