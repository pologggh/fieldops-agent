[
  {
    "id": "case_01_valid_request",
    "description": "Standard complete request routed successfully through intake and dispatch to operator proposal review.",
    "input": {
      "service_type": "HVAC",
      "urgency": "medium",
      "location": "Shinjuku",
      "preferred_time": "tomorrow morning",
      "required_skills": ["HVAC"]
    },
    "expected_action": "wait_for_approval",
    "expected_route": "build_appointment_proposal",
    "expected_role": "operator",
    "expected_reason_code": "PROPOSAL_READY"
  },
  {
    "id": "case_02_missing_location",
