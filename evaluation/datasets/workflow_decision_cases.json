      "location": null,
      "preferred_time": "tomorrow afternoon",
      "required_skills": ["Plumbing"]
    },
    "expected_action": "dispatch",
    "expected_route": "dispatch_subgraph",
    "expected_reason_code": "MISSING_LOCATION"
  },
  {
    "id": "case_03_missing_time",
