# ==============================================================================
# FieldOps Agent - Local Development Environment Template
# Copy to .env for local development.
# ==============================================================================

APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://fieldops:fieldops@localhost:5432/fieldops
REDIS_URL=redis://localhost:6379/0

CHECKPOINTER_BACKEND=sqlite
CHECKPOINT_DB_PATH=checkpoints.sqlite

OPENAI_API_KEY=sk-proj-placeholder
OPENAI_MODEL=gpt-4o-mini

CALENDAR_PROVIDER=fake
EMAIL_PROVIDER=fake
ALLOW_FAKE_INTEGRATIONS_IN_PRODUCTION=false

WEBHOOK_SHARED_SECRET=fieldops-webhook-secret-dev
JWT_SECRET=your-at-least-32-character-high-entropy-jwt-secret-here
ENABLE_FAKE_INTAKE=true
CORS_ORIGINS=["*"]
